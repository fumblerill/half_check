# Токен вашего Telegram бота (получить у @BotFather)
TELEGRAM_TOKEN=ваш_токен_здесь

# Список разрешенных ID пользователей Telegram через запятую
# Если пусто - доступ разрешен всем.
ALLOWED_USERS=12345678,87654321

# MySQL (for Docker Compose, keep MYSQL_HOST managed by Compose)
MYSQL_DATABASE=halfcheck
MYSQL_USER=halfcheck
MYSQL_PASSWORD=change_this_password
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
